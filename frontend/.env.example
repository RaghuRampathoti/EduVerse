# Base URL for the backend API.
# In local development, Vite proxies /api to http://localhost:8080 automatically.
# In production on Vercel, set VITE_API_URL to your deployed Render backend URL:
# Example: VITE_API_URL=https://your-render-backend.onrender.com/api
VITE_API_URL=https://your-render-backend.onrender.com/api
